# --- Userbot: the account the invites are actually sent FROM ---
# https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# Telethon session string. Generate once with:
#   python -m tgsender session
# This is the ONLY form of the login that survives a Railway redeploy — the
# .session file lives on an ephemeral disk and is wiped on every deploy.
# Treat it as a password: it is full read/write access to the account.
TG_SESSION=

# --- Control bot: the private panel you and your friends press buttons in ---
# Create with @BotFather. This bot never messages your guests.
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Who may use the panel. Numeric ids and/or @usernames, comma separated,
# mixed freely. The @ is optional and case does not matter:
#   ADMIN_IDS=111111111, @nylinary, some_friend
# Usernames are resolved to numeric ids at startup. Prefer ids where you
# have them: a username can be released and claimed by somebody else,
# and whoever holds it would reach a panel that sends from your account.
# Get ids from @userinfobot. Everyone else is ignored silently.
ADMIN_IDS=111111111,@yourusername

# --- State ---
# On Railway set this to the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/tgsender

# Label scoping this account's rows; several accounts can share one database.
TG_ACCOUNT=main
