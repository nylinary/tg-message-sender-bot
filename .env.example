# --- Userbot: the account the invites are actually sent FROM ---
# https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# --- Control bot: the private panel you and your friends press buttons in ---
# Create with @BotFather. This bot never messages your guests; it only drives
# the userbot above.
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Numeric Telegram user IDs allowed to use the panel, comma separated.
# Ask @userinfobot for yours. Everyone else is ignored silently.
ADMIN_IDS=111111111,222222222

# Label for this userbot account; each gets its own session + database.
TG_ACCOUNT=main
